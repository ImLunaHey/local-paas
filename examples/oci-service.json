{
  "schema_version": 1,
  "project": "sandbox",
  "environment": "development",
  "name": "web-canary",
  "source": {
    "repository": "https://github.com/example/web-canary.git",
    "commit": "0000000000000000000000000000000000000000"
  },
  "resources": { "cpu_millis": 500, "memory_mib": 512 },
  "distinct_nodes": true,
  "domains": [],
  "secrets": [],
  "workload": {
    "kind": "oci-service",
    "dockerfile": "Dockerfile",
    "context": ".",
    "replicas": 2,
    "port": 3000,
    "readiness": { "path": "/health", "interval_seconds": 10, "stabilization_seconds": 30 }
  }
}
