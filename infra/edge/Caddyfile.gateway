# Separate private gateway. Bind only the enrolled NetBird address, never all LANs.
{
	admin off
	auto_https off
}

https://:18444 {
	bind {$PLATFORM_GATEWAY_NETBIRD_ADDRESS}
	tls {$PLATFORM_GATEWAY_CERT_FILE} {$PLATFORM_GATEWAY_KEY_FILE} {
		client_auth {
			mode require_and_verify
			trust_pool file {$PLATFORM_EDGE_CA_FILE}
		}
	}
	reverse_proxy 127.0.0.1:8090 {
		header_up Host {http.request.header.X-Local-Paas-Route}
		header_up -X-Local-Paas-Route
		flush_interval -1
		stream_close_delay 5m
	}
}
