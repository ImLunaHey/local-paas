# Deployment input, NOT an active configuration. Enumerate verified domains only.
{
	admin off
	email {$PLATFORM_ACME_EMAIL}
	storage file_system {
		root /var/lib/local-paas-edge/caddy
	}
}

{$PLATFORM_DOMAINS} {
	reverse_proxy https://{$PLATFORM_LAKE_NETBIRD_ADDRESS}:18444 {
		header_up Host {http.request.host}
		flush_interval -1
		stream_close_delay 5m
		transport http {
			tls_server_name ingress.local-paas
			tls_trust_pool file {$PLATFORM_EDGE_CA_FILE}
			tls_client_auth {$PLATFORM_EDGE_CERT_FILE} {$PLATFORM_EDGE_KEY_FILE}
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
